erDiagram
  ZONA ||--o{ SECTOR : contiene
  SECTOR ||--o{ PUNTO_ATENCION : contiene
  ZONA ||--o{ USUARIO : "zona principal"
  ZONA ||--o{ NECESIDAD : tiene
  ZONA ||--o{ RECURSO : tiene
  ZONA ||--o{ ALBERGUE : tiene
  ZONA ||--o{ PERSONA : ubica
  ZONA ||--o{ MASCOTA : ubica
  USUARIO ||--o{ NECESIDAD : reporta
  USUARIO ||--o{ ACTIVIDAD : genera
  USUARIO ||--o{ MENSAJE : envia
  RECURSO ||--o{ MOVIMIENTO : registra
  NECESIDAD |o--o{ MOVIMIENTO : "recibe asignacion"
  PERSONA ||--o{ MENSAJE : recibe
  PERSONA ||--o{ HISTORIAL_ESTADO : acumula
  ALBERGUE |o--o{ PERSONA : aloja
  ALBERGUE |o--o{ NECESIDAD : "asociada_a"
  PERSONA |o--o{ NECESIDAD : "asociada_a"
  MASCOTA ||--o{ COINCIDENCIA : participa

  USUARIO {
    string username PK
    string password_hash "SHA-256"
    string nombre_completo
    atom tipo "ciudadano, voluntario, coordinador, administrador"
    string zona FK
    boolean conectado "no se persiste"
  }
  ZONA {
    string codigo PK
    string nombre
    atom nivel "critico, alto, medio, bajo"
    integer personas_afectadas "estimacion"
    list sectores "lista de Sector"
  }
  SECTOR {
    string codigo PK
    string nombre
    integer personas_afectadas
    list puntos_atencion "lista de PuntoAtencion"
  }
  PUNTO_ATENCION {
    string codigo PK
    string nombre
    integer personas_afectadas
  }
  NECESIDAD {
    string id PK "N001"
    atom tipo "agua, alimentos, medicamentos, ..."
    string tipo_otro "si tipo es otra"
    string descripcion
    integer cantidad_requerida
    integer cantidad_asignada
    string zona FK
    atom prioridad "critica 4, alta 3, media 2, baja 1"
    string responsable FK "username"
    atom estado "pendiente, asignada, en_atencion, atendida, cancelada"
    tuple asociada_a "zona, albergue o persona"
    string fecha "ISO 8601"
  }
  RECURSO {
    string id PK "R001"
    string nombre
    atom categoria "mismos valores que tipo de necesidad"
    integer cantidad_disponible "nunca negativa"
    string unidad
    string ubicacion "centro de apoyo"
    string zona FK
  }
  MOVIMIENTO {
    string id PK
    string recurso_id FK
    atom tipo "entrada, salida, asignacion, transferencia_salida, transferencia_entrada"
    integer cantidad
    string fecha
    string usuario FK
    string referencia "id de necesidad o centro destino"
  }
  PERSONA {
    string documento PK
    string nombre
    integer edad "0 a 120"
    string zona FK
    atom estado "sin_informacion, reportada, localizada, trasladada, en_albergue, reunificada"
    list historial "mas reciente primero"
  }
  HISTORIAL_ESTADO {
    string documento FK
    string fecha
    atom de "estado anterior o nil"
    atom a "estado nuevo"
    string usuario
  }
  MENSAJE {
    string id PK "MS001"
    string fecha
    string remitente FK "username"
    string documento_destinatario FK
    string contenido
    atom estado "pendiente, entregado"
  }
  MASCOTA {
    string id PK "M001"
    atom tipo "perdida, encontrada"
    string especie
    string nombre "nil si se desconoce"
    string caracteristicas
    string color
    atom tamano "pequeno, mediano, grande"
    string zona FK
    string contacto
    atom estado "activa, posible_coincidencia, resuelta"
  }
  COINCIDENCIA {
    string perdida_id FK
    string encontrada_id FK
    integer puntaje "0 a 100, umbral 60, calculado"
  }
  ALBERGUE {
    string id PK "A01"
    string nombre
    string zona FK
    integer capacidad_maxima
    integer ocupacion_actual "no supera la capacidad"
    mapset personas "documentos ingresados"
  }
  ACTIVIDAD {
    string fecha
    string usuario FK
    atom comando
    string resultado "ok o error:razon"
  }
